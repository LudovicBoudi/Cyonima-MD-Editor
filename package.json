{
  "name": "cyonima-md-editor",
  "version": "0.1.0",
  "description": "Un editeur Markdown WYSIWYG, aussi simple qu'un traitement de texte.",
  "main": "./out/main/index.js",
  "author": "Cyonima",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.renderer.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm test && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "icons": "python3 scripts/generate-icons.py",
    "benchmark": "node scripts/benchmark.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=critical",
    "sbom": "node scripts/generate-sbom.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.55.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-code-block": "^3.32.2",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-color": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^25.0.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "marked": "^14.0.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.cyonima.mdeditor",
    "productName": "Cyonima MD Editor",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "icons",
      "maintainer": "Cyonima",
      "vendor": "Cyonima",
      "synopsis": "Editeur Markdown WYSIWYG",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "verifyUpdateCodeSignature": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.icns",
      "notarize": true,
      "hardenedRuntime": true
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "description": "Document Markdown",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "description": "Document Markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "mdown",
        "name": "Markdown",
        "description": "Document Markdown",
        "mimeType": "text/x-markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "mkd",
        "name": "Markdown",
        "description": "Document Markdown",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "nsis": {
      "perMachine": true
    },
    "artifactName": "Cyonima-MD-Editor-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "LudovicBoudi",
        "repo": "Cyonima-MD-Editor"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "js-yaml": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LudovicBoudi/Cyonima-MD-Editor.git"
  },
  "desktopName": "cyonima-md-editor.desktop"
}
